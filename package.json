{
  "name": "alpha-vault",
  "private": true,
  "version": "0.1.0",
  "description": "Privacy-preserving AI trading agent leaderboard on Midnight blockchain",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "compile-contract": "pnpm --filter contract compile",
